# ============================================================
# TenMu — environment config
# Copy to `.env` and fill in your values (DID NOT COMMIT .env)
# ============================================================

# Supabase — Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google AI Studio (Gemini) — used server-side in the chat-bot Edge Function
# (NOT embedded in the app; keep as a Supabase secret too)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OneSignal push notifications (optional, app push)
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# MapLibre vector tiles — https://cloud.maptiler.com/account/keys
MAPTILER_KEY=YOUR_MAPTILER_KEY