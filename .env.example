# ============================================================
# TenMu — environment config
# Copy to `.env` and fill in your values (DID NOT COMMIT .env)
# ============================================================

# Supabase — Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google AI Studio (Gemini) — used server-side in the chat-bot Edge Function
# (NOT embedded in the app; keep as a Supabase secret too)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OneSignal push notifications (optional, app push)
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# MapLibre vector tiles — https://cloud.maptiler.com/account/keys
MAPTILER_KEY=YOUR_MAPTILER_KEY

# Kontak admin untuk menu Pengaturan → Pusat Bantuan
# ADMIN_WA format 62xxx tanpa +/spasi/tanda hubung. Contoh: 6281234567890
ADMIN_WA=
# Email admin (opsional) untuk tombol "Kirim Email" di Pusat Bantuan
ADMIN_EMAIL=

# ── Catatan: SMTP Gmail untuk kode OTP login ─────────────────────────────
# App Password Gmail TIDAK ditaruh di file ini. File .env ini di-bundle sebagai
# asset ke dalam APK/IPA, jadi rahasia apa pun di sini ikut terkirim ke user.
# Isi kredensial SMTP di sisi server saja:
#   • Project hosted  → Supabase Dashboard → Authentication → Emails → SMTP Settings
#   • Local dev       → `supabase secrets set SUPABASE_AUTH_SMTP_PASS=...`
# Lihat komentar [auth.email.smtp] di supabase/config.toml.
